extends "res://tests/water_sort_v1/animation_bridge_test.gd"
# Gameplay contract, not a duplicate of the component's liquid geometry tests.
var seal_events: Array=[]
func on_sealed(index: int) -> void: seal_events.append(index)
func run() -> void:
	root.size=Vector2i(540,960)
	game=load("res://scenes/experiments/water_sort_v1.tscn").instantiate()
	game.level_completed.connect(func(_i,_m,_t): wins+=1)
	root.add_child(game);await process_frame;game.set_process(false)
	await click(game.buttons.Start)
	for i in game.bottle_nodes.size(): game.bottle_nodes[i].visual.seal_finished.connect(on_sealed.bind(i))
	check(not game.bottle_nodes[0].visual.sealed and not game.bottle_nodes[1].visual.sealed,"initial mixed full bottles do not receive corks")
	await start_pour();settle_visuals()
	check(seal_events.is_empty(),"two matching layers do not trigger completion decoration")
	await click(game.bottle_nodes[1]);await click(game.bottle_nodes[0])
	var target=game.bottle_nodes[0].visual
	check(game.rules.bottles[0].size()==4 and not target.sealed and not target.cork.visible,"atomic full bottle does not flash a finished cork before its visible pour")
	game._process(game.animator.seal_start_time-0.001)
	check(not target.cork.visible and game.state=="playing","cork waits until transfer has visibly finished")
	game._process(0.08)
	check(target.seal_animating and target.cork.visible and target.seal_progress>0 and target.seal_progress<1,"completed colour receives actual short descending cork motion")
	var progress: float=target.seal_progress
	var position: Vector2=target.cork.position
	game._refresh()
	check(target.seal_progress==progress and target.cork.position==position,"HUD refresh cannot reset a partial cork animation")
	game.pause_game();var seconds: float=game.elapsed
	game._process(0.4)
	check(game.elapsed==seconds and target.seal_progress==progress and target.cork.position==position,"pause freezes liquid, cork, and timer together")
	check(game._animation_busy() and game.buttons.Undo.disabled,"transaction stays locked throughout pending cork motion")
	game.resume_game();settle_visuals()
	check(target.sealed and not target.seal_animating and seal_events==[0],"first completed bottle seals exactly once")
	game._refresh();game._refresh()
	check(seal_events==[0],"routine redraw never repeats a sealing celebration")
	await click(game.bottle_nodes[1]);await click(game.bottle_nodes[2])
	game._process(game.animator.seal_start_time+0.10)
	check(game.rules.is_solved() and game.state=="playing" and wins==0 and game.animator.busy,"last logical win waits for the visible cork before result or reward")
	check(game.bottle_nodes[2].visual.seal_animating and game.overlay==null,"final cork remains visible without a covering victory panel")
	settle_visuals()
	check(game.state=="won" and wins==1 and seal_events==[0,2],"victory appears once after both final caps have settled")
	check(game.bottle_nodes[0].visual.sealed and game.bottle_nodes[2].visual.sealed,"won board keeps completed bottles corked")
	game.undo_move()
	check(game.state=="playing" and game.bottle_nodes[0].visual.sealed and not game.bottle_nodes[1].visual.sealed and not game.bottle_nodes[2].visual.sealed,"undo restores exactly the matching sealed/unsealed bottle states")
	check(seal_events==[0,2],"undo restore emits no new cork celebration")
	await click(game.bottle_nodes[1]);await click(game.bottle_nodes[2]);settle_visuals()
	check(wins==1,"undo/retry after a won level cannot duplicate its settlement")
	game.load_level(0)
	check(not game.bottle_nodes[0].visual.sealed and not game.bottle_nodes[1].visual.sealed,"restart resets completed caps to initial mixed puzzle")
	# A complete sealed bottle remains movable under the original standard rules.
	game.rules.restore({"capacity":4,"bottles":[["red","red","red","red"],["yellow","yellow","yellow","yellow"],[]]});game._refresh()
	check(game.bottle_nodes[0].visual.sealed and game.rules.can_pour(0,2),"snapshot restore seals immediately without inventing an immovable bottle rule")
	await click(game.bottle_nodes[0]);await click(game.bottle_nodes[2])
	check(game.animator.source_was_sealed and game.bottle_nodes[0].visual.cork.visible,"pouring a completed bottle preserves its prior cork for removal")
	game._process(0.05)
	check(game.bottle_nodes[0].visual.cork.modulate.a>0 and game.bottle_nodes[0].visual.cork.modulate.a<1,"legal outgoing move visibly lifts/removes the old cork")
	settle_visuals()
	check(game.bottle_nodes[0].layers.is_empty() and not game.bottle_nodes[0].visual.cork.visible and game.bottle_nodes[2].visual.sealed,"four-layer move transfers only liquid and seals the newly completed destination")
	game.undo_move();game.set_locale("en")
	check(game.bottle_nodes[0].visual.sealed and not game.bottle_nodes[2].visual.sealed,"locale rebuild preserves restored complete caps without playing them again")
	# Full capacity alone is not completion; target remains mixed after this legal one-layer pour.
	game.load_level(1)
	game.rules.restore({"capacity":4,"bottles":[["red","red","green","green"],["blue","blue","green"],["red","red","blue","blue"],["green"]]});game._refresh()
	await click(game.bottle_nodes[0]);await click(game.bottle_nodes[1])
	check(game.rules.bottles[1].size()==4 and not game.animator.needs_target_seal,"a legal move filling a mixed bottle does not request a cork")
	settle_visuals()
	check(not game.bottle_nodes[1].visual.sealed and not game.bottle_nodes[1].visual.cork.visible,"mixed full destination remains open")
	# Early navigation during a final cork must settle the already committed result once.
	game.load_level(0)
	for action in [[0,2],[1,0]]:
		await click(game.bottle_nodes[action[0]]);await click(game.bottle_nodes[action[1]]);settle_visuals()
	await click(game.bottle_nodes[1]);await click(game.bottle_nodes[2]);game._process(game.animator.seal_start_time+0.05)
	var old_wins: int=wins
	game.prepare_to_leave()
	check(game.state=="won" and not game.animator.busy and game.bottle_nodes[2].visual.sealed and wins==old_wins+1,"leaving during final cork safely commits its one result and finished visual state")
	game.prepare_to_leave()
	check(wins==old_wins+1,"repeated leave during settled cork cannot duplicate completion")
	print("WATER_SORT_CORK_BRIDGE ",JSON.stringify({"checks":checks,"failures":failures,"passed":failures.is_empty()}))
	game.queue_free();await process_frame;quit(0 if failures.is_empty() else 1)
