    "actions": {
      "zh_option": "apply zh immediately through existing localization; preserve attempt/board/energy",
      "en_option": "apply en immediately through existing localization; preserve attempt/board/energy",
      "back_button": "close language child only; return to caller pause/settings"
    },
    "rules": [
      "Both audio flags are independent; sample on/off states are not defaults.",
      "Music OFF uses music_off.png; Sound OFF uses sound_off.png, not just text color.",
      "No image has baked language labels, numbers or ON/OFF text.",
      "Language selected option uses existing gold frame, non-selected option existing blue pill; do not change colors.",
      "Home-origin Settings contains no Resume/Restart/Home actions.",
      "No settings change resets board, changes attempt, or debits energy.",
      "Modal input blocker and timer pause behavior must reuse existing runtime."
    ]
  },
  "background_binding": "live caller scene, no static gameplay image"
